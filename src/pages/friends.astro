---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { profileConfig, siteConfig } from "@/config";

const FRIENDS_META = {
	title: "友链",
	description: "我的朋友们",
};

const FRIENDS = [
	{
		name: "Dogxi 的狗窝",
		href: "https://blog.dogxi.me",
		desc: "因为热爱所以热爱",
		avatar: "https://blog.dogxi.me/avatar.png",
	},
	{
		name: "微光拾级",
		href: "https://vow0328.github.io",
		desc: "记录可供回忆的时光",
		avatar: "https://vow0328.github.io/img/vow.jpg",
	},
];

const siteUrl = Astro.site?.toString() ?? "https://blog.sleepwf.dev";
const githubIssuesUrl = "https://github.com/Games55k/iBlog/issues";
const contactEmail = "Games55k@163.com";
const emailSubject = encodeURIComponent("友链申请");
const emailBody = encodeURIComponent(
	`名称：
    链接：
	描述：
	头像：`,
);

const mySite = {
	name: profileConfig.name,
	url: siteUrl,
	desc: siteConfig.subtitle,
	avatar: new URL("favicon/proflie.png", siteUrl).href,
};

const siteInfoText = `名称：${mySite.name}
链接：${mySite.url}
描述：${mySite.desc}
头像：${mySite.avatar}`;
---

<MainGridLayout title={FRIENDS_META.title} description={FRIENDS_META.description}>
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-6 py-6 md:px-9 md:py-7 relative w-full">
			<div class="space-y-3">
				<h1 class="friends-title text-3xl font-semibold">
					{FRIENDS_META.title}
				</h1>
				<p class="friends-lead max-w-2xl">
					有趣的灵魂，相互碰撞。
				</p>
			</div>

			<div class="mt-8 space-y-10">
				<section>
					<ul class="grid grid-cols-1 gap-4 sm:grid-cols-2">
						{
							FRIENDS.map((friend) => (
								<li class="friend-card group relative flex items-center overflow-hidden rounded-xl p-3 transition-all duration-300">
									<div class="friend-avatar mr-3 ml-1 h-10 w-10 shrink-0 overflow-hidden rounded-full">
										<img
											src={friend.avatar}
											alt={`${friend.name} Avatar`}
											class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.08]"
											loading="lazy"
										/>
									</div>

									<div class="min-w-0 pr-6">
										<div class="friend-name font-medium transition-colors">
											{friend.name}
										</div>
										<div class="friend-desc truncate text-sm transition-colors">
											{friend.desc}
										</div>
									</div>

									<a
										href={friend.href}
										target="_blank"
										rel="noopener noreferrer"
										class="absolute inset-0 z-10"
										aria-label={friend.name}
									/>
								</li>
							))
						}
					</ul>
				</section>

				<section>
					<details class="friends-panel group overflow-hidden rounded-xl">
						<summary class="friends-panel-summary flex cursor-pointer list-none items-center justify-between p-4 font-medium transition-colors">
							<span class="text-lg font-semibold">申请友链</span>
							<span class="transition-transform duration-300 group-open:rotate-180">
								<svg
									class="friends-panel-arrow h-5 w-5"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d="M6 9l6 6 6-6"></path>
								</svg>
							</span>
						</summary>

						<div class="friends-panel-body px-4 pt-4 pb-6 sm:px-6">
							<p class="friends-copy mb-4">
								欢迎交换友链，请确保你的网站满足这些基本条件：
							</p>
							<ul class="friends-rules mb-6 space-y-2 text-sm">
								<li class="flex items-start gap-2">
									<span class="mt-0.5 text-emerald-500">✓</span>
									<span>网站能够正常访问，内容健康向上。</span>
								</li>
							</ul>

							<div class="space-y-4">
								<h3 class="friends-section-label text-sm font-medium">
									本站信息
								</h3>
								<div class="friends-site-card overflow-hidden rounded-lg">
									<div class="friends-site-card-head flex items-center justify-between px-4 py-2">
										<span class="friends-site-card-meta text-xs">友链信息</span>
										<button
											id="copy-info"
											type="button"
											class="friends-copy-btn"
										>
											<svg
												class="h-3.5 w-3.5"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
												stroke-linecap="round"
												stroke-linejoin="round"
												aria-hidden="true"
											>
												<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
												<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
											</svg>
											复制
										</button>
									</div>
									<pre
										id="site-info"
										class="friends-site-card-code overflow-x-auto p-4 text-xs leading-6"
									><code>{siteInfoText}</code></pre>
								</div>
							</div>

							<div class="mt-6">
								<p class="friends-copy text-sm">
									如果想交换友链，可以通过邮件或 GitHub Issue 把你的站点信息发给我。
								</p>
								<div class="mt-3 flex flex-wrap gap-3">
									<a
										href={`mailto:${contactEmail}?subject=${emailSubject}&body=${emailBody}`}
										class="friends-action-btn is-primary"
									>
										<svg
											class="h-4 w-4"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
											aria-hidden="true"
										>
											<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
											<polyline points="22,6 12,13 2,6"></polyline>
										</svg>
										发送邮件
									</a>
									<a
										href={githubIssuesUrl}
										target="_blank"
										rel="noopener noreferrer"
										class="friends-action-btn"
									>
										<svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
											<path d="M12 0C5.373 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.49 11.49 0 0 1 12 5.799c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.562 21.8 24 17.302 24 12 24 5.373 18.627 0 12 0Z"></path>
										</svg>
										GitHub Issue
									</a>
								</div>
							</div>
						</div>
					</details>
				</section>
			</div>
		</div>
	</div>

	<div
		id="copy-toast"
		class="pointer-events-none fixed bottom-8 left-1/2 z-50 -translate-x-1/2 transform opacity-0 transition-all duration-300"
	>
		<div class="friends-toast rounded-lg px-4 py-2 text-sm shadow-lg">
			✓ 已复制到剪贴板
		</div>
	</div>
</MainGridLayout>

<script>
	function setupCopy() {
		const copyBtn = document.getElementById("copy-info");
		const siteInfo = document.getElementById("site-info");
		const toast = document.getElementById("copy-toast");

		if (!copyBtn || !siteInfo || !toast || copyBtn.dataset.bound === "true") return;

		copyBtn.dataset.bound = "true";
		copyBtn.addEventListener("click", async () => {
			const text = siteInfo.textContent || "";
			try {
				await navigator.clipboard.writeText(text);
				toast.classList.remove("opacity-0");
				toast.classList.add("opacity-100");
				window.setTimeout(() => {
					toast.classList.remove("opacity-100");
					toast.classList.add("opacity-0");
				}, 2000);
			} catch (error) {
				console.error("Failed to copy:", error);
			}
		});
	}

	setupCopy();
	document.addEventListener("astro:after-swap", setupCopy);
</script>

<style>
	.friends-title {
		color: rgb(0 0 0 / 0.9);
	}

	.friends-lead,
	.friends-copy,
	.friends-rules {
		color: rgb(0 0 0 / 0.66);
	}

	.friends-section-label {
		color: rgb(0 0 0 / 0.76);
	}

	.friend-card {
		border: 1px solid color-mix(in oklab, var(--line-color) 88%, var(--primary) 12%);
		background:
			linear-gradient(180deg, color-mix(in oklab, var(--card-bg) 95%, var(--primary) 5%), var(--card-bg));
		box-shadow:
			0 16px 28px -24px color-mix(in oklab, black 24%, transparent),
			inset 0 1px 0 color-mix(in oklab, white 45%, transparent);
	}

	.friend-card::before {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(
			135deg,
			transparent 0%,
			transparent 50%,
			rgba(255, 255, 255, 0.08) 50%,
			rgba(255, 255, 255, 0.08) 100%
		);
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.friend-card:hover::before {
		opacity: 1;
	}

	.friend-card:hover {
		border-color: color-mix(in oklab, var(--primary) 26%, transparent);
		background:
			linear-gradient(180deg, color-mix(in oklab, var(--card-bg) 90%, var(--primary) 10%), color-mix(in oklab, var(--card-bg) 98%, var(--primary) 2%));
		box-shadow:
			0 20px 34px -24px color-mix(in oklab, var(--primary) 18%, transparent),
			inset 0 1px 0 color-mix(in oklab, white 55%, transparent);
	}

	.friend-avatar {
		box-shadow:
			0 8px 20px -16px color-mix(in oklab, black 40%, transparent),
			0 0 0 1px color-mix(in oklab, var(--line-color) 84%, transparent);
	}

	.friend-name {
		color: rgb(0 0 0 / 0.86);
	}

	.friend-desc {
		color: rgb(0 0 0 / 0.62);
	}

	:global(.dark) .friend-card::before {
		background: linear-gradient(
			135deg,
			transparent 0%,
			transparent 50%,
			rgba(255, 255, 255, 0.04) 50%,
			rgba(255, 255, 255, 0.04) 100%
		);
	}

	:global(.dark) .friends-title {
		color: rgb(255 255 255 / 0.92);
	}

	:global(.dark) .friends-lead,
	:global(.dark) .friends-copy,
	:global(.dark) .friends-rules {
		color: rgb(255 255 255 / 0.68);
	}

	:global(.dark) .friends-section-label {
		color: rgb(255 255 255 / 0.8);
	}

	:global(.dark) .friend-card {
		border-color: color-mix(in oklab, var(--line-color) 88%, var(--primary) 12%);
		background:
			linear-gradient(180deg, color-mix(in oklab, var(--card-bg) 94%, white 6%), var(--card-bg));
		box-shadow:
			0 20px 34px -26px color-mix(in oklab, black 62%, transparent),
			inset 0 1px 0 color-mix(in oklab, white 10%, transparent);
	}

	:global(.dark) .friend-card:hover {
		border-color: color-mix(in oklab, var(--primary) 24%, transparent);
		background:
			linear-gradient(180deg, color-mix(in oklab, var(--card-bg) 86%, var(--primary) 14%), color-mix(in oklab, var(--card-bg) 98%, var(--primary) 2%));
		box-shadow:
			0 22px 38px -28px color-mix(in oklab, black 70%, transparent),
			inset 0 1px 0 color-mix(in oklab, white 12%, transparent);
	}

	:global(.dark) .friend-name {
		color: rgb(255 255 255 / 0.9);
	}

	:global(.dark) .friend-desc {
		color: rgb(255 255 255 / 0.64);
	}

	.friends-panel {
		border: 1px solid color-mix(in oklab, var(--line-color) 90%, var(--primary) 10%);
		background:
			linear-gradient(180deg, color-mix(in oklab, var(--card-bg) 97%, var(--primary) 3%), color-mix(in oklab, var(--card-bg) 99%, transparent));
	}

	.friends-panel-summary {
		color: rgb(0 0 0 / 0.86);
	}

	.friends-panel-summary:hover {
		background: color-mix(in oklab, var(--btn-plain-bg-hover) 80%, transparent);
	}

	.friends-panel-arrow {
		color: rgb(0 0 0 / 0.42);
	}

	.friends-panel-body {
		border-top: 1px solid color-mix(in oklab, var(--line-color) 90%, var(--primary) 10%);
	}

	.friends-site-card {
		border: 1px solid color-mix(in oklab, var(--line-color) 88%, var(--primary) 12%);
		background:
			linear-gradient(180deg, color-mix(in oklab, var(--card-bg) 98%, var(--primary) 2%), var(--card-bg));
	}

	.friends-site-card-head {
		border-bottom: 1px solid color-mix(in oklab, var(--line-color) 90%, var(--primary) 10%);
		background: color-mix(in oklab, var(--btn-regular-bg) 52%, transparent);
	}

	.friends-site-card-meta {
		color: rgb(0 0 0 / 0.5);
	}

	.friends-site-card-code {
		color: rgb(0 0 0 / 0.76);
	}

	.friends-toast {
		color: white;
		background:
			linear-gradient(180deg, color-mix(in oklab, var(--primary) 72%, black 28%), color-mix(in oklab, var(--primary) 82%, black 18%));
		box-shadow:
			0 20px 36px -20px color-mix(in oklab, var(--primary) 42%, transparent);
	}

	:global(.dark) .friends-panel {
		border-color: color-mix(in oklab, var(--line-color) 90%, var(--primary) 10%);
		background:
			linear-gradient(180deg, color-mix(in oklab, var(--card-bg) 96%, white 4%), color-mix(in oklab, var(--card-bg) 99%, transparent));
	}

	:global(.dark) .friends-panel-summary {
		color: rgb(255 255 255 / 0.88);
	}

	:global(.dark) .friends-panel-summary:hover {
		background: color-mix(in oklab, var(--btn-plain-bg-hover) 70%, transparent);
	}

	:global(.dark) .friends-panel-arrow {
		color: rgb(255 255 255 / 0.42);
	}

	:global(.dark) .friends-panel-body {
		border-top-color: color-mix(in oklab, var(--line-color) 88%, var(--primary) 12%);
	}

	:global(.dark) .friends-site-card {
		border-color: color-mix(in oklab, var(--line-color) 88%, var(--primary) 12%);
		background:
			linear-gradient(180deg, color-mix(in oklab, var(--card-bg) 98%, white 2%), var(--card-bg));
	}

	:global(.dark) .friends-site-card-head {
		border-bottom-color: color-mix(in oklab, var(--line-color) 88%, var(--primary) 12%);
		background: color-mix(in oklab, var(--btn-regular-bg) 38%, transparent);
	}

	:global(.dark) .friends-site-card-meta {
		color: rgb(255 255 255 / 0.46);
	}

	:global(.dark) .friends-site-card-code {
		color: rgb(255 255 255 / 0.76);
	}

	:global(.dark) .friends-toast {
		color: rgb(15 23 42 / 0.96);
		background:
			linear-gradient(180deg, color-mix(in oklab, var(--primary) 86%, white 14%), color-mix(in oklab, var(--primary) 78%, white 22%));
	}

	summary::-webkit-details-marker {
		display: none;
	}

	.friends-copy-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		border: 1px solid color-mix(in oklab, var(--primary) 14%, var(--line-color));
		border-radius: 999px;
		padding: 0.35rem 0.72rem;
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--btn-content);
		background: color-mix(in oklab, var(--btn-regular-bg) 92%, var(--primary) 8%);
		box-shadow: inset 0 1px 0 color-mix(in oklab, white 42%, transparent);
		transition:
			transform 0.18s ease,
			border-color 0.18s ease,
			background-color 0.18s ease,
			color 0.18s ease,
			box-shadow 0.18s ease;
	}

	.friends-copy-btn:hover {
		transform: translateY(-1px);
		border-color: color-mix(in oklab, var(--primary) 26%, transparent);
		background: color-mix(in oklab, var(--btn-regular-bg-hover) 88%, var(--primary) 12%);
		color: var(--primary);
		box-shadow:
			0 10px 22px -16px color-mix(in oklab, var(--primary) 40%, transparent),
			inset 0 1px 0 color-mix(in oklab, white 55%, transparent);
	}

	.friends-copy-btn:active {
		transform: translateY(0);
		background: color-mix(in oklab, var(--btn-regular-bg-active) 90%, var(--primary) 10%);
	}

	.friends-action-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		border: 1px solid color-mix(in oklab, var(--primary) 12%, var(--line-color));
		border-radius: 0.95rem;
		padding: 0.78rem 1rem;
		font-size: 0.92rem;
		font-weight: 700;
		line-height: 1;
		color: rgb(0 0 0 / 0.78);
		background:
			linear-gradient(180deg, color-mix(in oklab, var(--card-bg) 94%, var(--primary) 6%), var(--card-bg));
		box-shadow:
			0 16px 28px -22px color-mix(in oklab, black 38%, transparent),
			inset 0 1px 0 color-mix(in oklab, white 45%, transparent);
		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			background 0.2s ease,
			color 0.2s ease,
			box-shadow 0.2s ease;
	}

	:global(.dark) .friends-action-btn {
		color: rgb(255 255 255 / 0.82);
	}

	.friends-action-btn svg {
		opacity: 0.8;
		transition:
			transform 0.2s ease,
			opacity 0.2s ease;
	}

	.friends-action-btn:hover {
		transform: translateY(-2px);
		border-color: color-mix(in oklab, var(--primary) 24%, transparent);
		background:
			linear-gradient(180deg, color-mix(in oklab, var(--card-bg) 88%, var(--primary) 12%), color-mix(in oklab, var(--card-bg) 96%, var(--primary) 4%));
		color: var(--primary);
		box-shadow:
			0 18px 30px -22px color-mix(in oklab, var(--primary) 32%, transparent),
			inset 0 1px 0 color-mix(in oklab, white 55%, transparent);
	}

	.friends-action-btn:hover svg {
		opacity: 1;
		transform: translateX(1px);
	}

	.friends-action-btn:active {
		transform: translateY(0);
	}

	.friends-action-btn.is-primary {
		border-color: color-mix(in oklab, var(--primary) 28%, transparent);
		color: white;
		background:
			linear-gradient(180deg, color-mix(in oklab, var(--primary) 82%, white 18%), color-mix(in oklab, var(--primary) 90%, black 10%));
		box-shadow:
			0 18px 30px -18px color-mix(in oklab, var(--primary) 45%, transparent),
			inset 0 1px 0 color-mix(in oklab, white 35%, transparent);
	}

	:global(.dark) .friends-action-btn.is-primary {
		color: rgb(15 23 42 / 0.95);
		background:
			linear-gradient(180deg, color-mix(in oklab, var(--primary) 88%, white 12%), color-mix(in oklab, var(--primary) 76%, white 24%));
	}

	.friends-action-btn.is-primary:hover {
		border-color: color-mix(in oklab, var(--primary) 44%, transparent);
		color: white;
		background:
			linear-gradient(180deg, color-mix(in oklab, var(--primary) 88%, white 12%), color-mix(in oklab, var(--primary) 82%, black 18%));
		box-shadow:
			0 20px 34px -18px color-mix(in oklab, var(--primary) 54%, transparent),
			inset 0 1px 0 color-mix(in oklab, white 42%, transparent);
	}

	:global(.dark) .friends-action-btn.is-primary:hover {
		color: rgb(15 23 42 / 0.95);
	}

	@media (max-width: 640px) {
		.friends-action-btn {
			width: 100%;
			justify-content: center;
		}
	}
</style>
