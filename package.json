{
  "name": "astro-doge",
  "packageManager": "bun@1.3.11",
  "type": "module",
  "version": "1.2.0",
  "description": "A static-first Astro blog template with posts, thoughts, albums, search, PWA, and optional Vercel-ready GitHub-powered comments, likes, and publishing.",
  "license": "MIT",
  "homepage": "https://github.com/dogxii/astro-doge",
  "repository": {
    "type": "git",
    "url": "https://github.com/dogxii/astro-doge.git"
  },
  "bugs": {
    "url": "https://github.com/dogxii/astro-doge/issues"
  },
  "keywords": [
    "astro",
    "blog",
    "template",
    "theme",
    "tailwindcss",
    "mdx",
    "pwa"
  ],
  "scripts": {
    "dev": "astro dev",
    "dev:network": "astro dev --host",
    "build": "rm -rf .astro node_modules/.vite && astro check && astro build",
    "preview": "astro preview",
    "preview:network": "astro preview --host",
    "astro": "astro",
    "format": "prettier . --write",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "new:blog": "bun run scripts/new-blog.ts",
    "new:thought": "bun run scripts/new-thought.ts",
    "new": "bun run scripts/new-blog.ts",
    "t": "bun run scripts/new-thought.ts",
    "pwa:icons": "bun run scripts/generate-pwa-icons.ts",
    "pwa:check": "bun run scripts/check-pwa.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/vercel": "^11.0.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "astro": "^7.2.0",
    "astro-expressive-code": "^0.44.1",
    "clsx": "^2.1.1",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.1.0",
    "hastscript": "^9.0.1",
    "katex": "^0.17.0",
    "mermaid": "^11.16.1",
    "rehype-components": "^0.3.0",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.4"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "dompurify": "3.4.13",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.5",
    "fast-xml-builder": "1.3.0",
    "fast-xml-parser": "5.10.1",
    "path-to-regexp": "6.3.0",
    "postcss": "8.5.25",
    "svgo": "4.0.2",
    "tar": "7.5.22",
    "yaml": "2.9.0"
  }
}
