# Online thoughts publishing
# Used by `src/pages/api/add-thought.ts`

# Browser-side API token entered on `/thoughts/new`
THOUGHT_API_TOKEN=replace-with-a-long-random-string

# GitHub repo write access token
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GitHub owner and repo for this blog
GITHUB_OWNER=Games55k
GITHUB_REPO=iBlog

# Optional: defaults to `main`
GITHUB_BRANCH=main

# Optional: defaults to `src/content/thoughts`
THOUGHTS_DIR=src/content/thoughts
